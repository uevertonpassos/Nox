QWidget { color: @text; font-size: 13px; }
QMainWindow, QDialog { background: @background; }
QLabel { background: transparent; border: none; }
QLabel#brand { font-size: 27px; font-weight: 700; }
QLabel#eyebrow, QLabel#sectionLabel { color: @muted; font-size: 10px; font-weight: 600; }
QLabel#heading { font-size: 28px; font-weight: 700; }
QLabel#subtitle, QLabel#description, QLabel#footnote { color: @muted; }
QLabel#system { color: @muted; background: @surface; border: 1px solid @border; border-radius: 14px; padding: 7px 12px; font-size: 11px; }
QLabel#toolName { font-size: 15px; font-weight: 600; }
QLabel#toolCategory { color: @muted; font-size: 10px; }
QLabel#status { color: @muted; background: @raised; border-radius: 9px; padding: 5px 8px; font-size: 11px; }
QLabel#status[detected="true"] { color: @success; background: @successBackground; }
QLabel#message, QLabel#catalogTitle { font-weight: 600; }
QLabel#toolCount { color: @accent; font-size: 12px; }
QFrame#sidebar { background: @surface; border: 1px solid @border; border-radius: 14px; }
QFrame#tool { background: @surface; border: 1px solid @border; border-radius: 12px; }
QFrame#tool:hover { border-color: @muted; }
QFrame#divider { background: @border; max-height: 1px; border: none; }
QLabel#toolIcon { background: #f2f5f0; border-radius: 10px; }
QLabel#toolIcon[dark="true"] { background: #272b2f; }
QPushButton { background: @raised; border: 1px solid @border; border-radius: 8px; padding: 8px 12px; min-height: 16px; }
QPushButton:hover { border-color: @muted; }
QPushButton:pressed { background: @field; }
QPushButton:focus, QComboBox:focus { border: 1px solid @accent; }
QPushButton[primary="true"] { background: @accent; color: @accentText; border: 1px solid @accent; font-weight: 600; }
QPushButton[primary="true"]:hover { border-color: @text; }
QPushButton[nav="true"] { text-align: left; background: transparent; border: 1px solid transparent; padding: 10px 12px; }
QPushButton[nav="true"]:hover { background: @raised; }
QPushButton[nav="true"]:checked { background: @accent; color: @accentText; font-weight: 600; }
QPushButton:disabled { background: @surface; color: @muted; border-color: @border; }
QComboBox { background: @raised; border: 1px solid @border; border-radius: 8px; padding: 9px 12px; min-height: 16px; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: url(:/chevron.svg); width: 10px; height: 6px; }
QComboBox QAbstractItemView { background: @surface; color: @text; selection-background-color: @accent; selection-color: @accentText; border: 1px solid @border; padding: 4px; }
QLineEdit { background: @field; border: 1px solid @border; border-radius: 9px; padding: 11px 12px; selection-background-color: @accent; selection-color: @accentText; }
QLineEdit:focus { border-color: @accent; }
QPlainTextEdit { background: @field; border: 1px solid @border; border-radius: 9px; padding: 9px; selection-background-color: @accent; selection-color: @accentText; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: @border; min-height: 28px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: @muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QProgressBar { border: none; background: @raised; border-radius: 2px; }
QProgressBar::chunk { background: @accent; border-radius: 2px; }
QRadioButton { spacing: 10px; padding: 10px; }
QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid @muted; border-radius: 7px; background: @field; }
QRadioButton::indicator:checked { background: @accent; border-color: @accent; }
QToolTip { background: @raised; color: @text; border: 1px solid @border; padding: 6px; }
